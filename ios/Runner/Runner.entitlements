<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. App Store Review Guideline 4.8 requires this
	     wherever the app offers a third-party login (Flame offers Google), so
	     shipping without it is a rejection, not a nice-to-have.

	     This entitlement must also be enabled on the App ID at
	     developer.apple.com. Until it is, a SIGNED build will fail to
	     provision — an unsigned build is unaffected. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push notifications. Same caveat as Sign in with Apple above: the App ID
	     at developer.apple.com must also have the Push Notifications capability
	     enabled, or a SIGNED build fails to provision.

	     `development` targets the APNs sandbox, which is what a device build
	     from Xcode uses. An App Store or TestFlight build needs `production`,
	     and Xcode rewrites this value during an archive with a distribution
	     profile — verify it in the archive's entitlements before shipping
	     rather than assuming, because a sandbox token is silently rejected by
	     production APNs and the only symptom is notifications never arriving. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
